# /etc/dwyt-airouter/litellm.env  (chmod 600, tulajdonos: airouter)
# A felhős szolgáltató kulcsa (a models.yaml cloud.api_key_env nevén), például OpenRouter:
OPENROUTER_API_KEY=sk-or-...
# A kliensek (futtató, OpenCode, Hermes) ezzel érik el a LiteLLM-et. Készítés: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-...
